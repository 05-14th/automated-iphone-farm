# BlueBubbles Server (runs under macOS user imsg01, loopback only)
BB_URL=http://127.0.0.1:12341
# Server password set in BlueBubbles Server > Settings. Sent as ?password= on every request.
BB_PASSWORD=
# Apple Account 01's iMessage email identity (the sender BlueBubbles controls)
SENDER01_EMAIL=
# clarioinc's own iMessage handle (consenting test recipient / inbound sender), e.g. meidy@clariocapital.com
TEST_RECIPIENT=
# Port the local webhook listener binds on 127.0.0.1
WEBHOOK_PORT=12391
