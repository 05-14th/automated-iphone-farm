# api/.env.example - copy to api/.env and fill in. api/.env is gitignored.
#
# NOTHING in this file may be a real secret. Fetch the Supabase key with:
#   supabase projects api-keys --project-ref yjtbjwnvbgriywbrhsez
# and generate the API token with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# --- Supabase: the ONLY thing this API talks to ------------------------------
# It never talks to BlueBubbles. It cannot - BlueBubbles is on 127.0.0.1:12341
# on the Mac mini, and the Node worker there is the only process that reaches it.
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key. BYPASSRLS. Server-side only; never ships to a browser.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# --- HTTP --------------------------------------------------------------------
# Bearer token required on every /v1/* route except /v1/health and the docs.
API_TOKEN=replace-me-with-32-random-bytes-hex
# Bind loopback and put a TLS reverse proxy in front (see DEPLOYMENT.md).
# 0.0.0.0 only if something else is terminating TLS and filtering.
API_HOST=127.0.0.1
API_PORT=8080

# --- Routing -----------------------------------------------------------------
# Which sender a BRAND NEW contact is pinned to when the caller names none.
# Existing contacts keep their sticky sender forever, regardless of this value.
DEFAULT_SENDER_SLUG=sender01

# --- Optional ----------------------------------------------------------------
LOG_LEVEL=info
# Serve /docs and /redoc. Turn off on a public deployment if you prefer.
DOCS_ENABLED=true
# CORS is OFF when empty. Comma-separated origins to enable it.
# A browser should not be holding API_TOKEN; think before setting this.
CORS_ORIGINS=
DB_TIMEOUT_SECONDS=20
