# bridge/.env.example - copy to bridge/.env and fill in. bridge/.env is gitignored.
#
# Secrets are NEVER committed. Fetch the Supabase keys with:
#   supabase projects api-keys --project-ref yjtbjwnvbgriywbrhsez
# BB_PASSWORD / BB_URL are NOT duplicated here: the bridge reads them from the
# repo-root .env (see BRIDGE_ROOT_ENV below). One copy of that password, ever.

# --- Supabase (system of record) -------------------------------------------
SUPABASE_URL=https://yjtbjwnvbgriywbrhsez.supabase.co
# service_role key. BYPASSRLS - server-side only, never ships to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gateway API ------------------------------------------------------------
# Bearer token every /v1/* caller must present. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_API_TOKEN=
BRIDGE_API_HOST=127.0.0.1
BRIDGE_API_PORT=12350

# --- Worker pacing ----------------------------------------------------------
# Deliberately slow. The constraint is Apple's tolerance for a new sender
# identity, not the machine. One message every 8-12s per sender, jittered.
WORKER_MIN_INTERVAL_MS=8000
WORKER_MAX_INTERVAL_MS=12000
# How often the claim loop wakes when the queue is empty.
WORKER_IDLE_POLL_MS=3000
# Per-call HTTP timeouts. message/text measured at 0.76s; chat/new measured at
# 75-120s and ALWAYS times out, so it gets a long leash and a reconcile pass.
BB_TIMEOUT_MESSAGE_MS=30000
BB_TIMEOUT_CHATNEW_MS=150000
BB_TIMEOUT_QUERY_MS=20000
# Grace period before reconciling a timed-out send, so AppleScript can settle.
RECONCILE_SETTLE_MS=5000

# --- Health checker ---------------------------------------------------------
HEALTH_INTERVAL_MS=60000
HEALTH_TIMEOUT_MS=10000
# Consecutive failed pings before a sender is flipped to status=failed.
HEALTH_FAIL_THRESHOLD=2

# --- Where the BlueBubbles password lives -----------------------------------
# Path to the repo-root .env that holds BB_PASSWORD / BB_URL. Relative paths
# resolve against the repo root.
BRIDGE_ROOT_ENV=.env

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
